<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvTagsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_screen"
        android:layout_marginEnd="@dimen/spacing_screen"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/all_tags"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTagsGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/polar_list_layout"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="24dp" />
</LinearLayout>
