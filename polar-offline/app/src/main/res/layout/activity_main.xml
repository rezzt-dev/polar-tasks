<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/drawerLayout"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  tools:context=".MainActivity">

  <!-- Contenido principal -->
  <androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/mainContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
      android:id="@+id/appBarLayout"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:fitsSystemWindows="true"
      android:background="?android:attr/colorBackground"
      android:stateListAnimator="@null"
      app:elevation="0dp"
      app:liftOnScroll="false">

      <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?android:attr/colorBackground"
        app:navigationContentDescription="@string/open_menu"
        app:navigationIcon="@drawable/ic_menu"
        app:title="@string/app_name" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
      android:id="@+id/fragmentContainer"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/fabAddTask"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom|end"
      android:layout_marginEnd="@dimen/spacing_screen"
      android:layout_marginBottom="@dimen/spacing_large"
      android:contentDescription="@string/create_task"
      app:srcCompat="@drawable/ic_add" />
  </androidx.coordinatorlayout.widget.CoordinatorLayout>

  <!-- Cajon lateral -->
  <com.google.android.material.navigation.NavigationView
    android:id="@+id/navigationView"
    android:layout_width="@dimen/drawer_width"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true"
    app:drawerLayoutCornerSize="20dp">

    <LinearLayout
      android:id="@+id/drawerContent"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:paddingTop="20dp"
      android:paddingBottom="12dp">

      <!-- Cabecera: marca y fecha de hoy -->
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/app_name"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface" />

      <TextView
        android:id="@+id/tvDrawerDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="lunes, 26 de octubre" />

      <!-- Secciones -->
      <LinearLayout
        android:id="@+id/btnHome"
        style="@style/Polar.DrawerItem"
        android:layout_marginTop="20dp">

        <ImageView
          style="@style/Polar.DrawerItem.Icon"
          android:src="@drawable/ic_home" />

        <TextView
          style="@style/Polar.DrawerItem.Label"
          android:text="@string/home" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/btnReminders"
        style="@style/Polar.DrawerItem">

        <ImageView
          style="@style/Polar.DrawerItem.Icon"
          android:src="@drawable/ic_tasks" />

        <TextView
          style="@style/Polar.DrawerItem.Label"
          android:text="@string/reminders" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/btnCalendar"
        style="@style/Polar.DrawerItem">

        <ImageView
          style="@style/Polar.DrawerItem.Icon"
          android:src="@drawable/ic_calendar" />

        <TextView
          style="@style/Polar.DrawerItem.Label"
          android:text="@string/calendar" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/btnTags"
        style="@style/Polar.DrawerItem"
        android:visibility="gone">

        <ImageView
          style="@style/Polar.DrawerItem.Icon"
          android:src="@drawable/ic_label" />

        <TextView
          style="@style/Polar.DrawerItem.Label"
          android:text="@string/all_tags" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/btnEisenhower"
        style="@style/Polar.DrawerItem"
        android:visibility="gone">

        <ImageView
          style="@style/Polar.DrawerItem.Icon"
          android:src="@drawable/ic_grid" />

        <TextView
          style="@style/Polar.DrawerItem.Label"
          android:text="@string/eisenhower_matrix" />
      </LinearLayout>

      <!-- Listas -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="14dp">

        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/lists"
          android:textAppearance="@style/TextAppearance.Polar.Section" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btnCreateList"
          style="@style/Widget.Polar.Button.Icon"
          android:layout_width="36dp"
          android:layout_height="36dp"
          android:contentDescription="@string/create_list"
          android:insetTop="0dp"
          android:insetBottom="0dp"
          android:tooltipText="@string/create_list"
          app:icon="@drawable/ic_add"
          app:iconSize="18dp" />
      </LinearLayout>

      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTaskLists"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingBottom="8dp"
        tools:itemCount="4"
        tools:listitem="@layout/item_task_list" />

      <!-- Pie: herramientas -->
      <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/colorOutlineVariant" />

      <LinearLayout
        android:id="@+id/btnStats"
        style="@style/Polar.DrawerItem">

        <ImageView
          style="@style/Polar.DrawerItem.Icon"
          android:src="@drawable/ic_stats" />

        <TextView
          style="@style/Polar.DrawerItem.Label"
          android:text="@string/statistics" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/btnTrash"
        style="@style/Polar.DrawerItem">

        <ImageView
          style="@style/Polar.DrawerItem.Icon"
          android:src="@drawable/ic_trash" />

        <TextView
          style="@style/Polar.DrawerItem.Label"
          android:text="@string/trash" />

        <TextView
          android:id="@+id/tvTrashCount"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:duplicateParentState="true"
          android:textAppearance="?attr/textAppearanceLabelMedium"
          android:textColor="?attr/colorOnSurfaceVariant"
          android:visibility="gone"
          tools:text="3"
          tools:visibility="visible" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/btnSettings"
        style="@style/Polar.DrawerItem">

        <ImageView
          style="@style/Polar.DrawerItem.Icon"
          android:src="@drawable/ic_settings" />

        <TextView
          style="@style/Polar.DrawerItem.Label"
          android:text="@string/settings" />
      </LinearLayout>
    </LinearLayout>
  </com.google.android.material.navigation.NavigationView>
</androidx.drawerlayout.widget.DrawerLayout>
