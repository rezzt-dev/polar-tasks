<?xml version="1.0" encoding="utf-8"?>
<!--
  Vista previa en vivo del editor de tema personalizado: una pantalla de tareas en miniatura con
  la lista (acento en contenedor), el progreso (acento), una tarea por prioridad y el boton de
  anadir (acento). Todos los colores se asignan desde CustomThemePreview.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/previewCard"
    style="@style/Widget.Polar.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="false"
    android:focusable="true"
    android:importantForAccessibility="yes">

    <FrameLayout
        android:id="@+id/previewCanvas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/previewHeading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/today"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/previewChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="@string/custom_theme_preview_list"
                    android:textAppearance="?attr/textAppearanceLabelMedium" />
            </LinearLayout>

            <TextView
                android:id="@+id/previewProgressLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/custom_theme_preview_progress"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/previewProgress"
                style="@style/Widget.Polar.LinearProgressIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="2dp"
                android:progress="25" />

            <include
                android:id="@+id/previewTaskHigh"
                layout="@layout/view_custom_theme_preview_task" />

            <include
                android:id="@+id/previewTaskMedium"
                layout="@layout/view_custom_theme_preview_task" />

            <include
                android:id="@+id/previewTaskLow"
                layout="@layout/view_custom_theme_preview_task" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/previewFab"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            tools:ignore="UselessParent">

            <ImageView
                android:id="@+id/previewFabIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_add" />
        </FrameLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
