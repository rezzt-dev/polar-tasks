<?xml version="1.0" encoding="utf-8"?>
<!--
  editor del tema personalizado (CustomThemeActivity): vista previa fija arriba, paletas de fondo,
  acento y prioridades en la zona desplazable y boton de aplicar abajo.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:stateListAnimator="@null"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/menu_custom_theme"
            app:navigationContentDescription="@string/back"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/custom_theme_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <include
        android:id="@+id/preview"
        layout="@layout/view_custom_theme_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_screen"
        android:layout_marginEnd="@dimen/spacing_screen"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollOptions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <include
            android:id="@+id/options"
            layout="@layout/view_custom_theme_options" />
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApply"
        style="@style/Widget.Polar.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_screen"
        android:layout_marginEnd="@dimen/spacing_screen"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        tools:text="@string/custom_theme_apply" />
</LinearLayout>
