<?xml version="1.0" encoding="utf-8"?>
<!--
  dialogo de crear / editar tarea.
  titulo y descripcion sin caja, como un editor; debajo, filas de propiedades uniformes
  (fecha, repeticion, prioridad, lista, estimacion, etiquetas y subtareas). la botonera queda fija.
  el titulo se analiza mientras se escribe (SmartParser) y las filas muestran lo que se detecta.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/dialog_background"
  android:orientation="vertical">

  <TextView
    android:id="@+id/tvDialogTitle"
    style="@style/Polar.DialogTitle"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="4dp"
    android:text="@string/create_task" />

  <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fadingEdgeLength="24dp"
    android:overScrollMode="ifContentScrolls"
    android:requiresFadingEdge="vertical"
    android:scrollbars="none">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:paddingBottom="8dp">

      <!-- Titulo y descripcion -->
      <EditText
        android:id="@+id/etTaskTitle"
        style="@style/Polar.InlineInput"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:hint="@string/task_title_hint"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="3" />

      <!-- Ejemplo de lenguaje natural al crear, o aviso si "@lista" no existe -->
      <TextView
        android:id="@+id/tvSmartHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:text="@string/smart_parser_hint"
        tools:visibility="visible" />

      <EditText
        android:id="@+id/etTaskDescription"
        style="@style/Polar.InlineInput.Secondary"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:gravity="top"
        android:hint="@string/task_description_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLines="6"
        android:minLines="1" />

      <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="?attr/colorOutlineVariant" />

      <!-- Fecha -->
      <LinearLayout
        android:id="@+id/containerDate"
        style="@style/Polar.FormRow"
        android:clickable="true"
        android:focusable="true">

        <ImageView
          style="@style/Polar.FormRow.Icon"
          android:src="@drawable/ic_calendar" />

        <TextView
          android:id="@+id/tvDueDate"
          style="@style/Polar.FormRow.Text"
          tools:text="@string/no_due_date" />
      </LinearLayout>

      <!-- Aviso (solo con fecha): a la hora, con antelacion o sin aviso -->
      <LinearLayout
        android:id="@+id/containerAlert"
        style="@style/Polar.FormRow"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
          style="@style/Polar.FormRow.Icon"
          android:src="@drawable/ic_notifications" />

        <TextView
          android:id="@+id/tvAlert"
          style="@style/Polar.FormRow.Text"
          tools:text="@string/task_alert_at_due" />
      </LinearLayout>

      <!-- Repeticion -->
      <LinearLayout
        android:id="@+id/containerRecurrence"
        style="@style/Polar.FormRow"
        android:clickable="true"
        android:focusable="true">

        <ImageView
          style="@style/Polar.FormRow.Icon"
          android:src="@drawable/ic_sync" />

        <TextView
          android:id="@+id/tvRecurrence"
          style="@style/Polar.FormRow.Text"
          tools:text="@string/recurrence_summary_none" />
      </LinearLayout>

      <!-- Prioridad -->
      <LinearLayout
        android:id="@+id/containerPriority"
        style="@style/Polar.FormRow"
        android:clickable="true"
        android:focusable="true">

        <ImageView
          android:id="@+id/ivPriorityIcon"
          style="@style/Polar.FormRow.Icon"
          android:src="@drawable/ic_flag" />

        <TextView
          android:id="@+id/tvPriority"
          style="@style/Polar.FormRow.Text"
          tools:text="@string/priority_label_none" />
      </LinearLayout>

      <!-- Lista (solo si hay mas de una a la que mover la tarea) -->
      <LinearLayout
        android:id="@+id/containerList"
        style="@style/Polar.FormRow"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
          android:id="@+id/ivListIcon"
          style="@style/Polar.FormRow.Icon"
          android:src="@drawable/ic_list" />

        <TextView
          android:id="@+id/tvList"
          style="@style/Polar.FormRow.Text"
          tools:text="@string/no_list" />
      </LinearLayout>

      <!-- Estimacion -->
      <LinearLayout style="@style/Polar.FormRow">

        <ImageView
          style="@style/Polar.FormRow.Icon"
          android:src="@drawable/ic_hourglass" />

        <EditText
          android:id="@+id/etTimeEstimate"
          style="@style/Polar.InlineInput.Secondary"
          android:layout_width="0dp"
          android:layout_weight="1"
          android:layout_marginStart="14dp"
          android:hint="@string/time_estimate_hint"
          android:inputType="number"
          android:maxLength="4"
          android:maxLines="1" />
      </LinearLayout>

      <!-- Etiquetas -->
      <LinearLayout style="@style/Polar.FormRow">

        <ImageView
          style="@style/Polar.FormRow.Icon"
          android:src="@drawable/ic_label" />

        <EditText
          android:id="@+id/etTag"
          style="@style/Polar.InlineInput.Secondary"
          android:layout_width="0dp"
          android:layout_weight="1"
          android:layout_marginStart="14dp"
          android:hint="@string/tags_hint"
          android:imeOptions="actionDone"
          android:inputType="text"
          android:maxLines="1" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btnAddTag"
          style="@style/Widget.Polar.Button.IconTonal"
          android:layout_width="36dp"
          android:layout_height="36dp"
          android:contentDescription="@string/add_tag"
          android:insetTop="0dp"
          android:insetBottom="0dp"
          app:icon="@drawable/ic_add"
          app:iconSize="18dp" />
      </LinearLayout>

      <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupTags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="42dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        app:chipSpacingHorizontal="6dp"
        app:chipSpacingVertical="0dp" />

      <!-- Subtareas -->
      <LinearLayout style="@style/Polar.FormRow">

        <ImageView
          style="@style/Polar.FormRow.Icon"
          android:src="@drawable/ic_check_box" />

        <EditText
          android:id="@+id/etSubtaskTitle"
          style="@style/Polar.InlineInput.Secondary"
          android:layout_width="0dp"
          android:layout_weight="1"
          android:layout_marginStart="14dp"
          android:hint="@string/subtask_hint"
          android:imeOptions="actionDone"
          android:inputType="textCapSentences"
          android:maxLines="1" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btnAddSubtask"
          style="@style/Widget.Polar.Button.IconTonal"
          android:layout_width="36dp"
          android:layout_height="36dp"
          android:contentDescription="@string/add_subtask"
          android:insetTop="0dp"
          android:insetBottom="0dp"
          app:icon="@drawable/ic_add"
          app:iconSize="18dp" />
      </LinearLayout>

      <app.polar.ui.widget.MaxHeightRecyclerView
        android:id="@+id/recyclerSubtasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:fadeScrollbars="false"
        android:nestedScrollingEnabled="false"
        android:scrollbars="vertical" />

    </LinearLayout>
  </androidx.core.widget.NestedScrollView>

  <!-- Botonera -->
  <LinearLayout style="@style/Polar.DialogActions">

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btnCancel"
      style="@style/Widget.Polar.Button.Text.Neutral"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="8dp"
      android:text="@string/cancel" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btnSave"
      style="@style/Widget.Polar.Button"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:minWidth="112dp"
      android:text="@string/save" />
  </LinearLayout>
</LinearLayout>
