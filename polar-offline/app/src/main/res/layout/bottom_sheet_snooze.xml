<?xml version="1.0" encoding="utf-8"?>
<!-- hoja inferior de posponer un aviso: opciones rapidas y fecha y hora a medida -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <com.google.android.material.bottomsheet.BottomSheetDragHandleView
    style="@style/Widget.Polar.BottomSheet.DragHandle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" />

  <TextView
    android:id="@+id/tvSnoozeTitle"
    style="@style/Polar.DialogTitle"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:text="@string/snooze_title" />

  <TextView
    android:id="@+id/tvSnoozeSubtitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:ellipsize="end"
    android:maxLines="2"
    android:textAppearance="?attr/textAppearanceBodyMedium"
    android:textColor="?attr/colorOnSurfaceVariant"
    android:visibility="gone"
    tools:text="pagar la factura de la luz"
    tools:visibility="visible" />

  <LinearLayout
    android:id="@+id/containerSnoozeOptions"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp" />
</LinearLayout>
