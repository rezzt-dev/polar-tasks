<resources xmlns:tools="http://schemas.android.com/tools">
  <!--
    Temas de polar.

    Cada tema solo define color. Tipografia, formas, estilos de componentes y animaciones
    viven en `ThemeOverlay.Polar.Foundation` (styles.xml), que `BaseActivity` aplica encima
    de cualquier tema: asi todos los temas comparten exactamente el mismo sistema visual.
  -->

  <!-- Polar claro -->
  <style name="Base.Theme.Polar" parent="Platform.Theme.Polar.Light">
    <item name="colorPrimary">@color/light_primary</item>
    <item name="colorOnPrimary">@color/light_on_primary</item>
    <item name="colorPrimaryContainer">@color/light_surface_container_high</item>
    <item name="colorOnPrimaryContainer">@color/light_foreground</item>
    <item name="colorPrimaryInverse">@color/light_inverse_primary</item>

    <item name="colorSecondary">@color/light_primary</item>
    <item name="colorOnSecondary">@color/light_on_primary</item>
    <item name="colorSecondaryContainer">@color/light_surface_container_high</item>
    <item name="colorOnSecondaryContainer">@color/light_foreground</item>
    <item name="colorTertiary">@color/light_primary</item>
    <item name="colorOnTertiary">@color/light_on_primary</item>
    <item name="colorTertiaryContainer">@color/light_surface_container_high</item>
    <item name="colorOnTertiaryContainer">@color/light_foreground</item>

    <item name="colorError">@color/light_error</item>
    <item name="colorOnError">@color/white</item>
    <item name="colorErrorContainer">@color/light_error_container</item>
    <item name="colorOnErrorContainer">@color/light_on_error_container</item>
    <item name="colorSuccess">@color/light_success</item>
    <item name="colorOnSuccess">@color/white</item>

    <item name="colorPriorityHigh">@color/light_priority_high</item>
    <item name="colorPriorityMedium">@color/light_priority_medium</item>
    <item name="colorPriorityLow">@color/light_priority_low</item>
    <item name="colorDateOverdue">@color/light_error</item>

    <item name="android:colorBackground">@color/light_background</item>
    <item name="colorOnBackground">@color/light_foreground</item>
    <item name="colorSurface">@color/light_surface</item>
    <item name="colorOnSurface">@color/light_foreground</item>
    <item name="colorSurfaceVariant">@color/light_surface_container_high</item>
    <item name="colorOnSurfaceVariant">@color/light_foreground_variant</item>
    <item name="colorSurfaceContainerLowest">@color/light_surface_container_lowest</item>
    <item name="colorSurfaceContainerLow">@color/light_surface_container_low</item>
    <item name="colorSurfaceContainer">@color/light_surface_container</item>
    <item name="colorSurfaceContainerHigh">@color/light_surface_container_high</item>
    <item name="colorSurfaceContainerHighest">@color/light_surface_container_highest</item>
    <item name="colorSurfaceBright">@color/light_surface</item>
