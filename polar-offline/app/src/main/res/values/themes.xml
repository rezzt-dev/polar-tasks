    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">true</item>

    <item name="taskBackground">@color/light_surface</item>
    <item name="taskBorder">@color/light_outline_variant</item>
    <item name="mainBorder">@color/light_outline_variant</item>
    <item name="buttonBackground">@color/light_primary</item>
  </style>

  <style name="Theme.Polar" parent="Base.Theme.Polar" />

