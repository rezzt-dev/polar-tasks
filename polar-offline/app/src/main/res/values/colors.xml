  <!--
    Paleta de polar.

    Cada tema define el juego completo de roles de material 3 (fondo, superficies y sus
    contenedores, texto secundario, contornos, superficies inversas para snackbars, etc.).
    Los layouts y el codigo nunca usan estos colores directamente: siempre pasan por los
    atributos del tema (`?attr/colorSurface`, `?attr/colorOnSurfaceVariant`...).
  -->

  <!-- Base -->
  <color name="black">#000000</color>
  <color name="white">#FFFFFF</color>

  <!-- Semanticos compartidos por los temas de color (multicolor, pastel, neon, onyx) -->
  <color name="priority_high">#E5484D</color>
  <color name="priority_medium">#F59E0B</color>
  <color name="priority_low">#3B82F6</color>

  <!--
    POLAR (claro / oscuro): monocromo neutro de alto contraste.
    El acento es el propio color del texto, asi que botones, casillas y estados
    seleccionados leen como tinta sobre papel.
  -->

