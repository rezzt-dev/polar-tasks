  <!-- Tutorial -->
  <string name="tutorial_title_1">welcome to polar.</string>
  <string name="tutorial_desc_1">a minimalist app to organize your tasks and reminders without distractions.\n\neverything you need, nothing you don\'t.</string>
  <string name="tutorial_title_2">task management</string>
  <string name="tutorial_desc_2">group your tasks into lists for work, home or your projects, and organize them with tags.\n\nbreak big goals into subtasks and follow your progress at a glance.</string>
  <string name="tutorial_title_3">quick actions</string>
  <string name="tutorial_desc_3">swipe a task to the right to complete it instantly.\n\nswipe left to move it to the trash. touch and hold any task to see all its options.</string>
  <string name="tutorial_title_4">images</string>
  <string name="tutorial_desc_4">attach an image to any task to keep a visual reference. you\'ll find it in the task details.</string>
  <string name="tutorial_title_5">calendar and reminders</string>
  <string name="tutorial_desc_5">check your tasks and reminders day by day in the calendar.\n\ncreate reminders with a date, time and location to get notified exactly when you need it.</string>
  <string name="tutorial_title_6">your way</string>
  <string name="tutorial_desc_6">choose from seven themes: light, dark, multicolor light, multicolor dark, pastel, neon and onyx.\n\nyou can also adjust the font, the checkbox style and the text size.</string>
  <string name="tutorial_title_7">statistics and progress</string>
  <string name="tutorial_desc_7">track your completed and overdue tasks, your completion rate and your weekly activity.\n\nkeep your daily streak going and find out which day you\'re most productive.</string>
