<resources xmlns:tools="http://schemas.android.com/tools">
  <!-- Polar oscuro -->
  <style name="Theme.Polar" parent="Platform.Theme.Polar.Dark">
    <item name="colorPrimary">@color/dark_primary</item>
    <item name="colorOnPrimary">@color/dark_on_primary</item>
    <item name="colorPrimaryContainer">@color/dark_surface_container_high</item>
    <item name="colorOnPrimaryContainer">@color/dark_foreground</item>
    <item name="colorPrimaryInverse">@color/dark_inverse_primary</item>

    <item name="colorSecondary">@color/dark_primary</item>
    <item name="colorOnSecondary">@color/dark_on_primary</item>
    <item name="colorSecondaryContainer">@color/dark_surface_container_high</item>
    <item name="colorOnSecondaryContainer">@color/dark_foreground</item>
    <item name="colorTertiary">@color/dark_primary</item>
    <item name="colorOnTertiary">@color/dark_on_primary</item>
    <item name="colorTertiaryContainer">@color/dark_surface_container_high</item>
    <item name="colorOnTertiaryContainer">@color/dark_foreground</item>

    <item name="colorError">@color/dark_error</item>
    <item name="colorOnError">@color/black</item>
    <item name="colorErrorContainer">@color/dark_error_container</item>
    <item name="colorOnErrorContainer">@color/dark_on_error_container</item>
    <item name="colorSuccess">@color/dark_success</item>
    <item name="colorOnSuccess">@color/black</item>

    <item name="colorPriorityHigh">@color/dark_priority_high</item>
    <item name="colorPriorityMedium">@color/dark_priority_medium</item>
    <item name="colorPriorityLow">@color/dark_priority_low</item>
    <item name="colorDateOverdue">@color/dark_error</item>

    <item name="android:colorBackground">@color/dark_background</item>
    <item name="colorOnBackground">@color/dark_foreground</item>
    <item name="colorSurface">@color/dark_surface</item>
    <item name="colorOnSurface">@color/dark_foreground</item>
    <item name="colorSurfaceVariant">@color/dark_surface_container_high</item>
    <item name="colorOnSurfaceVariant">@color/dark_foreground_variant</item>
    <item name="colorSurfaceContainerLowest">@color/dark_surface_container_lowest</item>
