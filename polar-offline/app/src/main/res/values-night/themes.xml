    <item name="colorSurfaceContainerHigh">@color/dark_surface_container_high</item>
    <item name="colorSurfaceContainerHighest">@color/dark_surface_container_highest</item>
    <item name="colorSurfaceBright">@color/dark_surface_container_highest</item>
    <item name="colorSurfaceDim">@color/dark_background</item>
    <item name="colorSurfaceInverse">@color/dark_inverse_surface</item>
    <item name="colorOnSurfaceInverse">@color/dark_inverse_on_surface</item>
    <item name="colorOutline">@color/dark_outline</item>
    <item name="colorOutlineVariant">@color/dark_outline_variant</item>

    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">false</item>

    <item name="taskBackground">@color/dark_surface</item>
    <item name="taskBorder">@color/dark_outline_variant</item>
    <item name="mainBorder">@color/dark_outline_variant</item>
    <item name="buttonBackground">@color/dark_primary</item>
  </style>
</resources>
