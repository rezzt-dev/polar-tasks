  <!-- Tutorial -->
  <string name="tutorial_title_1">bienvenue dans polar.</string>
  <string name="tutorial_desc_1">une application minimaliste pour organiser vos tâches et vos rappels sans distraction.\n\ntout ce qu\'il faut, rien de superflu.</string>
  <string name="tutorial_title_2">gestion des tâches</string>
  <string name="tutorial_desc_2">regroupez vos tâches en listes pour le travail, la maison ou vos projets, et organisez-les avec des étiquettes.\n\ndivisez les grands objectifs en sous-tâches et suivez votre progression d\'un coup d\'œil.</string>
  <string name="tutorial_title_3">actions rapides</string>
  <string name="tutorial_desc_3">balayez une tâche vers la droite pour la terminer instantanément.\n\nbalayez vers la gauche pour la placer dans la corbeille. appuyez longuement sur une tâche pour voir toutes ses options.</string>
  <string name="tutorial_title_4">images</string>
  <string name="tutorial_desc_4">joignez une image à une tâche pour garder une référence visuelle. vous la retrouverez dans le détail de la tâche.</string>
  <string name="tutorial_title_5">calendrier et rappels</string>
  <string name="tutorial_desc_5">consultez vos tâches et vos rappels jour par jour dans le calendrier.\n\ncréez des rappels avec une date, une heure et un lieu pour être averti au bon moment.</string>
  <string name="tutorial_title_6">à votre façon</string>
  <string name="tutorial_desc_6">choisissez parmi sept thèmes : clair, sombre, multicolore clair, multicolore sombre, pastel, néon et onyx.\n\nréglez aussi la police, le style des cases et la taille du texte.</string>
  <string name="tutorial_title_7">statistiques et progression</string>
  <string name="tutorial_desc_7">suivez vos tâches terminées et en retard, votre taux de réalisation et votre activité hebdomadaire.\n\nentretenez votre série quotidienne et découvrez votre jour le plus productif.</string>
  <string name="action_next">suivant</string>
