<?xml version="1.0" encoding="utf-8"?>
<!-- cambio de seccion (fade through de material): la pantalla nueva aparece tras un
     breve retardo con un ligero escalado, sin desplazamientos laterales -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@anim/polar_emphasized_decelerate"
    android:startOffset="70">
    <alpha
        android:duration="210"
        android:fromAlpha="0"
        android:toAlpha="1" />
    <scale
        android:duration="210"
        android:fromXScale="0.98"
        android:fromYScale="0.98"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1"
        android:toYScale="1" />
</set>
