<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Sistema de diseno de polar.

      `ThemeOverlay.Polar.Foundation` se aplica en `BaseActivity` encima del tema de color
      elegido (antes que los overlays de fuente y de casilla). Reune todo lo que no es color:
      escala tipografica, formas, estilos por defecto de los componentes de material y
      animaciones de ventana. Los layouts deben usar `?attr/textAppearance*` y los estilos
      `Widget.Polar.*` en lugar de los de material directamente.
    -->
    <style name="ThemeOverlay.Polar.Foundation" parent="">
        <!-- Tipografia -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Polar.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Polar.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Polar.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Polar.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Polar.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Polar.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Polar.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Polar.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Polar.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Polar.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Polar.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Polar.LabelSmall</item>
        <item name="android:textAppearanceLargePopupMenu">@style/TextAppearance.Polar.PopupMenu</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/TextAppearance.Polar.PopupMenu</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.Polar.PopupMenu</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.Polar.PopupMenu</item>

        <!-- Formas -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.Polar.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Polar.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Polar.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Polar.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Polar.ExtraLarge</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Polar.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Polar.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Polar.Large</item>

        <!-- Superficies planas: sin tinte de elevacion, la jerarquia la dan los contenedores -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:listDivider">@drawable/divider_hairline</item>

        <!-- Componentes -->
        <item name="materialButtonStyle">@style/Widget.Polar.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Polar.Button.Outlined</item>
        <item name="materialIconButtonStyle">@style/Widget.Polar.Button.Icon</item>
        <item name="materialCardViewStyle">@style/Widget.Polar.Card</item>
        <item name="chipStyle">@style/Widget.Polar.Chip.Filter</item>
        <item name="polarInputChipStyle">@style/Widget.Polar.Chip.Input</item>
        <item name="floatingActionButtonStyle">@style/Widget.Polar.FloatingActionButton</item>
        <item name="toolbarStyle">@style/Widget.Polar.Toolbar</item>
        <item name="textInputStyle">@style/Widget.Polar.TextInputLayout.OutlinedBox</item>
        <item name="checkboxStyle">@style/Widget.Polar.Checkbox</item>
        <item name="materialSwitchStyle">@style/Widget.Polar.Switch</item>
        <item name="sliderStyle">@style/Widget.Polar.Slider</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.Polar.LinearProgressIndicator</item>
        <item name="circularProgressIndicatorStyle">@style/Widget.Polar.CircularProgressIndicator</item>
        <item name="materialDividerStyle">@style/Widget.Polar.Divider</item>
        <item name="snackbarStyle">@style/Widget.Polar.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/Widget.Polar.Snackbar.TextView</item>
        <item name="popupMenuStyle">@style/Widget.Polar.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.Polar.PopupMenu</item>
        <item name="popupMenuBackground">@drawable/bg_popup</item>
        <item name="actionOverflowMenuStyle">@style/Widget.Polar.PopupMenu.Overflow</item>
        <item name="listPopupWindowStyle">@style/Widget.Polar.PopupMenu.ListPopupWindow</item>

        <!-- Dialogos y hojas inferiores -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Polar.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Polar.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Polar.BottomSheetDialog</item>
        <item name="materialCalendarTheme">@style/ThemeOverlay.Polar.MaterialCalendar</item>
        <item name="materialTimePickerTheme">@style/ThemeOverlay.Polar.MaterialTimePicker</item>

        <!-- Movimiento -->
        <item name="android:windowAnimationStyle">@style/Animation.Polar.Activity</item>
    </style>

    <!-- ===================================================================== -->
    <!-- Tipografia: sin fontFamily para respetar la fuente elegida en ajustes -->
    <!-- ===================================================================== -->

    <style name="TextAppearance.Polar" parent="">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Polar.HeadlineLarge">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="lineHeight">36sp</item>
    </style>

    <style name="TextAppearance.Polar.HeadlineMedium">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="lineHeight">32sp</item>
    </style>

    <style name="TextAppearance.Polar.HeadlineSmall">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="lineHeight">28sp</item>
    </style>

    <style name="TextAppearance.Polar.TitleLarge">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="lineHeight">26sp</item>
    </style>

    <style name="TextAppearance.Polar.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight" tools:targetApi="28">500</item>
        <item name="android:letterSpacing">-0.005</item>
        <item name="lineHeight">22sp</item>
    </style>

    <style name="TextAppearance.Polar.TitleSmall">
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight" tools:targetApi="28">500</item>
        <item name="android:letterSpacing">0</item>
        <item name="lineHeight">20sp</item>
    </style>

    <style name="TextAppearance.Polar.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">-0.005</item>
        <item name="lineHeight">24sp</item>
    </style>

    <style name="TextAppearance.Polar.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="lineHeight">20sp</item>
    </style>

    <style name="TextAppearance.Polar.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.005</item>
        <item name="lineHeight">16sp</item>
    </style>

    <style name="TextAppearance.Polar.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight" tools:targetApi="28">500</item>
        <item name="android:letterSpacing">0</item>
        <item name="lineHeight">20sp</item>
    </style>

    <style name="TextAppearance.Polar.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textFontWeight" tools:targetApi="28">500</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="lineHeight">16sp</item>
    </style>

    <style name="TextAppearance.Polar.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textFontWeight" tools:targetApi="28">500</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="lineHeight">16sp</item>
    </style>

    <!-- Titulo de seccion en listas y ajustes: discreto, en minusculas como toda la interfaz -->
    <style name="TextAppearance.Polar.Section" parent="TextAppearance.Polar.LabelMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- ===================================================================== -->
    <!-- Formas                                                                 -->
    <!-- ===================================================================== -->

    <style name="ShapeAppearance.Polar.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>

    <style name="ShapeAppearance.Polar.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="ShapeAppearance.Polar.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Polar.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Polar.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>


    <style name="ShapeAppearance.Polar.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ===================================================================== -->
    <!-- Botones                                                                -->
    <!-- ===================================================================== -->

    <style name="Widget.Polar.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.Polar.Medium</item>
        <item name="android:textAppearance">@style/TextAppearance.Polar.LabelLarge</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>


    <style name="Widget.Polar.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.Polar.Medium</item>
        <item name="android:textAppearance">@style/TextAppearance.Polar.LabelLarge</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.Polar.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="shapeAppearance">@style/ShapeAppearance.Polar.Medium</item>
        <item name="android:textAppearance">@style/TextAppearance.Polar.LabelLarge</item>
    </style>

    <!-- Boton de texto neutro (cancelar, acciones secundarias) -->
    <style name="Widget.Polar.Button.Text.Neutral">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Polar.Button.Text.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="shapeAppearance">@style/ShapeAppearance.Polar.Medium</item>
        <item name="android:textAppearance">@style/TextAppearance.Polar.LabelLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.Polar.Button.Text.Dialog.Neutral">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Polar.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="iconSize">20dp</item>
    </style>

    <!-- Boton cuadrado de icono con fondo tonal (anadir etiqueta, anadir subtarea...) -->
    <style name="Widget.Polar.Button.IconTonal" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Polar.Medium</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="iconSize">20dp</item>
    </style>

    <!-- ===================================================================== -->
    <!-- Tarjetas, chips y entradas                                             -->
    <!-- ===================================================================== -->

    <style name="Widget.Polar.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Polar.Large</item>
    </style>

    <!-- Tarjeta rellena sin borde para agrupar contenido dentro de otra superficie -->
    <style name="Widget.Polar.Card.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Polar.Large</item>
    </style>

    <style name="Widget.Polar.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="shapeAppearance">@style/ShapeAppearance.Polar.Small</item>
        <item name="chipBackgroundColor">@color/polar_chip_background</item>
        <item name="chipStrokeColor">@color/polar_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/polar_chip_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Polar.LabelLarge</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconTint">@color/polar_chip_text</item>
        <item name="chipMinHeight">34dp</item>
        <item name="chipStartPadding">6dp</item>
        <item name="chipEndPadding">6dp</item>
        <item name="rippleColor">@color/polar_ripple_neutral</item>
    </style>

    <!-- Chip de entrada (etiqueta con boton de quitar) -->
    <style name="Widget.Polar.Chip.Input" parent="Widget.Material3.Chip.Input">
        <item name="shapeAppearance">@style/ShapeAppearance.Polar.Small</item>
        <item name="chipBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAppearance">@style/TextAppearance.Polar.LabelLarge</item>
        <item name="closeIcon">@drawable/ic_x</item>
        <item name="closeIconSize">14dp</item>
        <item name="closeIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:checkable">false</item>
        <item name="chipMinHeight">30dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <!-- Chip informativo, no seleccionable -->
    <style name="Widget.Polar.Chip.Assist" parent="Widget.Material3.Chip.Assist">
        <item name="shapeAppearance">@style/ShapeAppearance.Polar.Small</item>
        <item name="chipBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="chipIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAppearance">@style/TextAppearance.Polar.LabelMedium</item>
        <item name="chipMinHeight">28dp</item>
    </style>

    <style name="Widget.Polar.TextInputLayout.OutlinedBox" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.Polar.Medium</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Polar.Medium</item>
        <item name="boxStrokeColor">@color/polar_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="hintTextColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="endIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Entrada rellena sin subrayado: para formularios densos dentro de dialogos -->
    <style name="Widget.Polar.TextInputLayout.FilledBox" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="shapeAppearance">@style/ShapeAppearance.Polar.Medium</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Polar.Medium</item>
        <item name="boxBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintTextColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="endIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- ===================================================================== -->
    <!-- Barra superior, fab y controles                                        -->
    <!-- ===================================================================== -->

    <style name="Widget.Polar.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.Polar.TitleLarge</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.Polar.BodySmall</item>
        <item name="subtitleTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
        <item name="contentInsetStartWithNavigation">4dp</item>
    </style>

    <style name="Widget.Polar.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="tint">?attr/colorOnPrimary</item>
        <item name="rippleColor">@color/polar_ripple_on_primary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Polar.Fab</item>
        <item name="elevation">3dp</item>
        <item name="hoveredFocusedTranslationZ">1dp</item>
        <item name="pressedTranslationZ">2dp</item>
    </style>

    <style name="ShapeAppearance.Polar.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="Widget.Polar.Checkbox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonCompat">@drawable/sel_checkbox_square</item>
    </style>

    <style name="Widget.Polar.Checkbox.Circular">
        <item name="buttonCompat">@drawable/sel_checkbox_circular</item>
    </style>

    <style name="Overlay.Polar.Checkbox.Circular" parent="">
        <item name="checkboxStyle">@style/Widget.Polar.Checkbox.Circular</item>
    </style>

    <style name="Widget.Polar.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch" />

    <!-- Slider sin marcas de paso: el valor ya se muestra junto al control -->
    <style name="Widget.Polar.Slider" parent="Widget.Material3.Slider">
        <item name="tickVisible">false</item>
        <item name="trackHeight">6dp</item>
        <item name="trackColorActive">?attr/colorPrimary</item>
        <item name="trackColorInactive">?attr/colorSurfaceContainerHighest</item>
    </style>

    <style name="Widget.Polar.LinearProgressIndicator" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">4dp</item>
        <item name="trackCornerRadius">2dp</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="indicatorTrackGapSize">0dp</item>
        <item name="indicatorColor">?attr/colorPrimary</item>
        <item name="trackColor">?attr/colorSurfaceContainerHighest</item>
    </style>

    <style name="Widget.Polar.CircularProgressIndicator" parent="Widget.Material3.CircularProgressIndicator">
        <item name="trackCornerRadius">4dp</item>
        <item name="indicatorTrackGapSize">0dp</item>
        <item name="indicatorColor">?attr/colorPrimary</item>
        <item name="trackColor">?attr/colorSurfaceContainerHighest</item>
    </style>

    <style name="Widget.Polar.Divider" parent="Widget.Material3.MaterialDivider">
        <item name="dividerColor">?attr/colorOutlineVariant</item>
        <item name="dividerThickness">1dp</item>
    </style>

    <!-- ===================================================================== -->
    <!-- Snackbar y menus emergentes                                            -->
    <!-- ===================================================================== -->

    <style name="Widget.Polar.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="shapeAppearance">@style/ShapeAppearance.Polar.Medium</item>
        <item name="android:layout_margin">12dp</item>
    </style>

    <style name="Widget.Polar.Snackbar.TextView" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Polar.BodyMedium</item>
    </style>

    <!-- Color explicito para que los menus sean legibles en todos los temas. -->
    <style name="TextAppearance.Polar.PopupMenu" parent="TextAppearance.Polar.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.Polar.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup</item>
        <item name="android:popupElevation">6dp</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>

    <style name="Widget.Polar.PopupMenu.Overflow" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup</item>
        <item name="android:popupElevation">6dp</item>
    </style>

    <style name="Widget.Polar.PopupMenu.ListPopupWindow" parent="Widget.Material3.PopupMenu.ListPopupWindow">
        <item name="android:popupBackground">@drawable/bg_popup</item>
        <item name="android:popupElevation">6dp</item>
    </style>

    <!-- ===================================================================== -->
    <!-- Dialogos, hojas inferiores y selectores                               -->
    <!-- ===================================================================== -->

    <style name="ThemeOverlay.Polar.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Polar</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Polar.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.Polar.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Polar.Button.Text.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Polar.Button.Text.Dialog.Neutral</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Polar.Button.Text.Dialog.Neutral</item>
        <item name="android:backgroundDimAmount">0.32</item>
    </style>

    <style name="MaterialAlertDialog.Polar" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Polar.ExtraLarge</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Polar.ExtraLarge</item>
    </style>

    <style name="MaterialAlertDialog.Polar.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.Polar.TitleLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="MaterialAlertDialog.Polar.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">@style/TextAppearance.Polar.BodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Dialogos propios (TaskDialog, TaskListDialog...): ventana transparente, el layout
         pone su propio fondo redondeado con `@drawable/dialog_background` -->
    <style name="ThemeOverlay.Polar.Dialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:windowMinWidthMajor">@dimen/dialog_min_width</item>
        <item name="android:windowMinWidthMinor">@dimen/dialog_min_width</item>
    </style>

    <!-- Activity sin ventana propia que solo muestra una hoja inferior (posponer desde la
         notificacion). El tema del manifiesto decide que la app de debajo siga visible; el overlay
         lo reaplica sobre el tema de color que elige BaseActivity. -->
    <style name="Theme.Polar.Transparent" parent="Theme.Polar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="ThemeOverlay.Polar.Transparent" parent="">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="ThemeOverlay.Polar.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Polar.BottomSheet</item>
        <item name="android:backgroundDimAmount">0.32</item>
    </style>

    <style name="Widget.Polar.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Polar.BottomSheet</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Polar.BottomSheet</item>
    </style>

    <style name="Widget.Polar.BottomSheet.DragHandle" parent="Widget.Material3.BottomSheet.DragHandle">
        <item name="tint">?attr/colorOutline</item>
    </style>

    <style name="ThemeOverlay.Polar.MaterialCalendar" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="materialCalendarStyle">@style/Widget.Polar.MaterialCalendar</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Polar.Button.Text.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Polar.Button.Text.Dialog.Neutral</item>
    </style>

    <style name="Widget.Polar.MaterialCalendar" parent="Widget.Material3.MaterialCalendar">
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Polar.ExtraLarge</item>
    </style>

    <style name="ThemeOverlay.Polar.MaterialTimePicker" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="materialTimePickerStyle">@style/Widget.Polar.MaterialTimePicker</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Polar.Button.Text.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Polar.Button.Text.Dialog.Neutral</item>
    </style>

    <style name="Widget.Polar.MaterialTimePicker" parent="Widget.Material3.MaterialTimePicker">
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Polar.ExtraLarge</item>
    </style>

    <!-- ===================================================================== -->
    <!-- Movimiento                                                             -->
    <!-- ===================================================================== -->

    <!-- Transicion entre activities: entrada lateral corta con fundido, sin rebotes -->
    <style name="Animation.Polar.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/polar_activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/polar_activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/polar_activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/polar_activity_close_exit</item>
    </style>

    <!-- ===================================================================== -->
    <!-- Fuentes                                                                -->
    <!-- ===================================================================== -->

    <style name="Overlay.Polar.Font.Inter" parent="">
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
    </style>

    <style name="Overlay.Polar.Font.Poppins" parent="">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
    </style>

    <style name="Overlay.Polar.Font.Comfortaa" parent="">
        <item name="android:fontFamily">@font/comfortaa</item>
        <item name="fontFamily">@font/comfortaa</item>
    </style>

    <style name="Overlay.Polar.Font.Figtree" parent="">
        <item name="android:fontFamily">@font/figtree</item>
        <item name="fontFamily">@font/figtree</item>
    </style>

    <style name="Overlay.Polar.Font.JetBrainsMono" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="fontFamily">@font/jetbrains_mono</item>
    </style>

    <style name="Overlay.Polar.Font.Arial" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="Overlay.Polar.Font.System" parent="">
        <!-- Hereda la fuente por defecto del sistema -->
    </style>

    <!-- ===================================================================== -->
    <!-- Piezas reutilizables de layout                                         -->
    <!-- ===================================================================== -->

    <!-- Raiz de los estilos de layout `Polar.*` -->
    <style name="Polar" parent="" />


    <!-- Separador entre filas dentro de una tarjeta de ajustes -->
    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
        <item name="android:layout_marginStart">56dp</item>
    </style>

    <!-- Fila de navegacion del cajon lateral -->
    <style name="Polar.DrawerItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/bg_drawer_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Polar.DrawerItem.Icon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginEnd">0dp</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:background">@null</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/polar_drawer_icon</item>
    </style>

    <style name="Polar.DrawerItem.Label">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">0dp</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:background">@null</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAppearance">@style/TextAppearance.Polar.TitleSmall</item>
        <item name="android:textColor">@color/polar_drawer_text</item>
    </style>

    <!-- Estado vacio: icono grande, titulo y descripcion centrados -->
    <style name="Polar.EmptyState">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">40dp</item>
        <item name="android:paddingEnd">40dp</item>
        <item name="android:paddingTop">32dp</item>
        <item name="android:paddingBottom">32dp</item>
    </style>

    <style name="Polar.EmptyState.Icon">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:alpha">0.55</item>
        <item name="tint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Polar.EmptyState.Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.Polar.TitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Polar.EmptyState.Body">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.Polar.BodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Dialogos propios: cabecera, campos sin caja y botonera fija -->
    <style name="Polar.DialogTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Polar.TitleLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Campo de texto principal sin caja (titulo de tarea, lista...) -->
    <style name="Polar.InlineInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@null</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Polar.TitleMedium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="android:importantForAutofill" tools:targetApi="26">no</item>
    </style>

    <!-- Campo secundario sin caja (descripcion, entradas dentro de una fila) -->
    <style name="Polar.InlineInput.Secondary">
        <item name="android:textAppearance">@style/TextAppearance.Polar.BodyMedium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Titulo de seccion dentro de un dialogo u hoja inferior -->
    <style name="Polar.SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Polar.Section</item>
    </style>

    <!-- Fila de propiedad de un formulario: icono, texto y ripple redondeado -->
    <style name="Polar.FormRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:background">@drawable/bg_form_row</item>
    </style>

    <style name="Polar.FormRow.Icon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:background">@null</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Polar.FormRow.Text">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:background">@null</item>
        <item name="android:textAppearance">@style/TextAppearance.Polar.BodyLarge</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Botonera inferior de los dialogos propios -->
    <style name="Polar.DialogActions">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <!-- Cabecera de dia de la semana del calendario -->
    <style name="Polar.CalendarWeekday">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.Polar.LabelMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

</resources>
