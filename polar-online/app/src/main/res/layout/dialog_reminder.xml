<?xml version="1.0" encoding="utf-8"?>
<!-- hoja inferior de crear / editar recordatorio -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <com.google.android.material.bottomsheet.BottomSheetDragHandleView
    style="@style/Widget.Polar.BottomSheet.DragHandle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" />

  <TextView
    android:id="@+id/tvDialogTitle"
    style="@style/Polar.DialogTitle"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:text="@string/new_reminder" />

  <!-- Con la ubicacion desplegada el formulario puede no caber: los campos se desplazan y la
       botonera queda siempre visible -->
  <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="none">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="16dp"
      android:paddingEnd="16dp">

      <EditText
        android:id="@+id/etTitle"
        style="@style/Polar.InlineInput"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        android:hint="@string/reminder_title_hint"
        android:inputType="textCapSentences"
        android:maxLines="2" />

      <EditText
        android:id="@+id/etDescription"
        style="@style/Polar.InlineInput.Secondary"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:gravity="top"
        android:hint="@string/task_description_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLines="5" />

      <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="?attr/colorOutlineVariant" />

      <!-- Fecha y hora -->
      <LinearLayout
        android:id="@+id/btnDate"
        style="@style/Polar.FormRow"
        android:clickable="true"
        android:focusable="true">

        <ImageView
          style="@style/Polar.FormRow.Icon"
          android:src="@drawable/ic_schedule" />

        <TextView
          android:id="@+id/tvDueDate"
          style="@style/Polar.FormRow.Text"
          android:text="@string/select_date_time" />
      </LinearLayout>

      <!-- Ubicacion -->
      <LinearLayout style="@style/Polar.FormRow">

        <ImageView
          style="@style/Polar.FormRow.Icon"
          android:src="@drawable/ic_location" />

        <TextView
          style="@style/Polar.FormRow.Text"
          android:text="@string/add_location" />

        <com.google.android.material.materialswitch.MaterialSwitch
          android:id="@+id/switchLocation"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/layoutLocationSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="42dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:gravity="center_vertical"
          android:orientation="horizontal">

          <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Polar.TextInputLayout.FilledBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/google_maps_link_hint">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etMapsLink"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="textUri"
              android:maxLines="3" />
          </com.google.android.material.textfield.TextInputLayout>

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExtract"
            style="@style/Widget.Polar.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/extract_coordinates" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
          style="@style/Widget.Polar.TextInputLayout.FilledBox"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:hint="@string/location_name_hint">

          <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etLocationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:orientation="horizontal">

          <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Polar.TextInputLayout.FilledBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/latitude">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etLatitude"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="numberDecimal|numberSigned"
              android:maxLines="1" />
          </com.google.android.material.textfield.TextInputLayout>

          <Space
            android:layout_width="8dp"
            android:layout_height="wrap_content" />

          <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Polar.TextInputLayout.FilledBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/longitude">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etLongitude"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="numberDecimal|numberSigned"
              android:maxLines="1" />
          </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btnViewOnMap"
          style="@style/Widget.Polar.Button.Text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:text="@string/view_on_map"
          app:icon="@drawable/ic_navigation"
          app:iconSize="18dp" />

        <!-- Aviso al llegar: ademas de a su hora, al entrar en el radio del lugar -->
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:gravity="center_vertical"
          android:minHeight="48dp"
          android:orientation="horizontal">

          <TextView
            style="@style/Polar.FormRow.Text"
            android:layout_marginStart="0dp"
            android:text="@string/reminder_arrival" />

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchArrival"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
          android:id="@+id/layoutArrivalOptions"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:visibility="gone">

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reminder_arrival_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

          <TextView
            style="@style/Polar.SectionLabel"
            android:layout_marginTop="12dp"
            android:text="@string/reminder_arrival_radius" />

          <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupRadius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true" />

          <TextView
            android:id="@+id/tvArrivalStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>

  <LinearLayout
    style="@style/Polar.DialogActions"
    android:layout_marginTop="8dp">

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btnCancel"
      style="@style/Widget.Polar.Button.Text.Neutral"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="8dp"
      android:text="@string/cancel" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btnSave"
      style="@style/Widget.Polar.Button"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:minWidth="112dp"
      android:text="@string/save" />
  </LinearLayout>
</LinearLayout>
