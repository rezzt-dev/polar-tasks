<?xml version="1.0" encoding="utf-8"?>
<!-- desplegable de tareas completadas: fila discreta con contador y flecha -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootCompletedHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_completed_header"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <ImageView
        android:id="@+id/ivCompletedHeaderCheck"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check_circle"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/tvCompletedHeaderTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="completadas (3)" />

    <ImageView
        android:id="@+id/ivCompletedHeaderArrow"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_arrow_down"
        app:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
