<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="?android:attr/colorBackground">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Cabecera de inicio: saludo y resumen del dia -->
    <LinearLayout
      android:id="@+id/homeHeader"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="@dimen/spacing_screen"
      android:paddingEnd="@dimen/spacing_screen"
      android:paddingTop="8dp"
      android:paddingBottom="12dp">

      <TextView
        android:id="@+id/tvGreeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/good_morning"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:textColor="?attr/colorOnBackground" />

      <TextView
        android:id="@+id/tvHomeSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:text="4 tareas pendientes"
        tools:visibility="visible" />
    </LinearLayout>

    <!-- Filtros y orden (modo lista) -->
    <LinearLayout
      android:id="@+id/filterBar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="@dimen/spacing_screen"
      android:paddingEnd="12dp">

      <HorizontalScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadingEdgeLength="16dp"
        android:requiresFadingEdge="horizontal"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
          android:id="@+id/chipGroupFilters"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:chipSpacingHorizontal="8dp"
          app:selectionRequired="false"
          app:singleLine="true"
          app:singleSelection="false">

          <com.google.android.material.chip.Chip
            android:id="@+id/chipToday"
            style="@style/Widget.Polar.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/filter_today" />

          <com.google.android.material.chip.Chip
            android:id="@+id/chipPending"
            style="@style/Widget.Polar.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/filter_pending" />

          <com.google.android.material.chip.Chip
            android:id="@+id/chipOverdue"
            style="@style/Widget.Polar.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/filter_overdue" />

          <com.google.android.material.chip.Chip
            android:id="@+id/chipRecurrent"
            style="@style/Widget.Polar.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/filter_recurrent" />

        </com.google.android.material.chip.ChipGroup>
      </HorizontalScrollView>

      <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSort"
        style="@style/Widget.Polar.Button.Icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/sort_by"
        android:tooltipText="@string/sort_by"
        app:icon="@drawable/ic_sort" />
    </LinearLayout>

    <com.google.android.material.chip.Chip
      android:id="@+id/chipSortIndicator"
      style="@style/Widget.Polar.Chip.Assist"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_screen"
      android:text="@string/sort_unmark_first"
      android:visibility="gone"
      app:chipIcon="@drawable/ic_sort" />

    <!-- Progreso de la lista -->
    <LinearLayout
      android:id="@+id/progressContainer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="@dimen/spacing_screen"
      android:paddingEnd="@dimen/spacing_screen"
      android:paddingTop="8dp"
      android:paddingBottom="8dp"
      android:visibility="gone"
      tools:visibility="visible">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/tvProgressText"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:textAppearance="?attr/textAppearanceLabelMedium"
          android:textColor="?attr/colorOnSurfaceVariant"
          tools:text="3 de 8 completadas" />

        <TextView
          android:id="@+id/tvProgressPercent"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFeatureSettings="tnum"
          android:textAppearance="?attr/textAppearanceLabelMedium"
          android:textColor="?attr/colorOnSurface"
          tools:text="38 %" />
      </LinearLayout>

      <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:trackThickness="3dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/recyclerTasks"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:clipToPadding="false"
      android:layoutAnimation="@anim/polar_list_layout"
      android:paddingStart="12dp"
      android:paddingEnd="12dp"
      android:paddingBottom="112dp"
      tools:listitem="@layout/item_task" />

  </LinearLayout>

  <!-- Estado vacio -->
  <LinearLayout
    android:id="@+id/emptyState"
    style="@style/Polar.EmptyState"
    android:visibility="gone"
    tools:visibility="visible">

    <ImageView
      style="@style/Polar.EmptyState.Icon"
      android:src="@drawable/ic_empty_state" />

    <TextView
      android:id="@+id/tvEmptyTitle"
      style="@style/Polar.EmptyState.Title"
      android:text="@string/no_tasks" />

    <TextView
      android:id="@+id/tvEmptyBody"
      style="@style/Polar.EmptyState.Body"
      android:text="@string/add_first_task" />
  </LinearLayout>
</FrameLayout>
