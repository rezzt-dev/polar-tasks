<?xml version="1.0" encoding="utf-8"?>
<!--
  opciones del editor de tema personalizado: paletas de fondo (claros y oscuros), acento y un
  color por prioridad. las incluyen activity_custom_theme.xml en vertical y en horizontal.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_screen"
    android:paddingEnd="@dimen/spacing_screen"
    android:paddingBottom="@dimen/spacing_large">

    <!-- Fondo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvBackgroundHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/custom_theme_background"
            android:textAppearance="@style/TextAppearance.Polar.Section" />

        <TextView
            android:id="@+id/tvBackgroundValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="grafito" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/custom_theme_background_light"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/groupBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:chipSpacingHorizontal="@dimen/custom_theme_swatch_spacing"
        app:chipSpacingVertical="@dimen/custom_theme_swatch_spacing" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/custom_theme_background_dark"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/groupBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:chipSpacingHorizontal="@dimen/custom_theme_swatch_spacing"
        app:chipSpacingVertical="@dimen/custom_theme_swatch_spacing" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- Acento -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAccentHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/custom_theme_accent"
            android:textAppearance="@style/TextAppearance.Polar.Section" />

        <TextView
            android:id="@+id/tvAccentValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="azul" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/custom_theme_accent_desc"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/groupAccent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:chipSpacingHorizontal="@dimen/custom_theme_swatch_spacing"
        app:chipSpacingVertical="@dimen/custom_theme_swatch_spacing" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- Prioridades -->
    <TextView
        android:id="@+id/tvPrioritiesHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/custom_theme_priorities"
        android:textAppearance="@style/TextAppearance.Polar.Section" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/custom_theme_priorities_desc"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <include
        android:id="@+id/priorityHigh"
        layout="@layout/item_custom_theme_priority" />

    <include
        android:id="@+id/priorityMedium"
        layout="@layout/item_custom_theme_priority" />

    <include
        android:id="@+id/priorityLow"
        layout="@layout/item_custom_theme_priority" />
</LinearLayout>
