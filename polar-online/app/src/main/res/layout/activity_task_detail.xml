<?xml version="1.0" encoding="utf-8"?>
<!--
  detalle de tarea: misma gramatica visual que el dialogo de edicion.
  lista (migas) > casilla y titulo > filas de propiedades > notas > subtareas > fecha de creacion.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:stateListAnimator="@null"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="@string/back"
            app:navigationIcon="@drawable/ic_arrow_back" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Imagen adjunta -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/containerImage"
                style="@style/Widget.Polar.Card"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginStart="@dimen/spacing_screen"
                android:layout_marginEnd="@dimen/spacing_screen"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivTaskImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/attach_image"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Lista a la que pertenece -->
            <TextView
                android:id="@+id/tvDetailListName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_screen"
                android:layout_marginEnd="@dimen/spacing_screen"
                android:drawablePadding="6dp"
                android:includeFontPadding="false"
                android:gravity="center_vertical"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:drawableStartCompat="@drawable/ic_list_mini"
                app:drawableTint="?attr/colorOnSurfaceVariant"
                tools:text="trabajo" />

            <!-- Casilla y titulo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_screen"
                android:paddingEnd="@dimen/spacing_screen">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbDetailCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/mark_completed"
                    android:layout_gravity="center_vertical"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp" />

                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnBackground"
                    android:textIsSelectable="true"
                    tools:text="revisar la propuesta de diseño" />
            </LinearLayout>

            <!-- Propiedades -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:id="@+id/cardDueDate"
                    style="@style/Polar.FormRow"
                    android:background="@null"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        style="@style/Polar.FormRow.Icon"
                        android:src="@drawable/ic_calendar" />

                    <TextView
                        android:id="@+id/tvDetailDueDate"
                        style="@style/Polar.FormRow.Text"
                        tools:text="hoy · 10:30" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowRecurrence"
                    style="@style/Polar.FormRow"
                    android:background="@null"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        style="@style/Polar.FormRow.Icon"
                        android:src="@drawable/ic_sync" />

                    <TextView
                        android:id="@+id/tvDetailRecurrence"
                        style="@style/Polar.FormRow.Text"
                        tools:text="cada semana" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowAlert"
                    style="@style/Polar.FormRow"
                    android:background="@null"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        style="@style/Polar.FormRow.Icon"
                        android:src="@drawable/ic_notifications" />

                    <TextView
                        android:id="@+id/tvDetailAlert"
                        style="@style/Polar.FormRow.Text"
                        tools:text="avisar 1 día antes" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowPriority"
                    style="@style/Polar.FormRow"
                    android:background="@null"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/ivPriority"
                        style="@style/Polar.FormRow.Icon"
                        android:src="@drawable/ic_flag" />

                    <TextView
                        android:id="@+id/chipPriority"
                        style="@style/Polar.FormRow.Text"
                        tools:text="prioridad alta" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowEstimate"
                    style="@style/Polar.FormRow"
                    android:background="@null"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        style="@style/Polar.FormRow.Icon"
                        android:src="@drawable/ic_hourglass" />

                    <TextView
                        android:id="@+id/chipTimeEstimate"
                        style="@style/Polar.FormRow.Text"
                        tools:text="45 min" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowTags"
                    style="@style/Polar.FormRow"
                    android:background="@null"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        style="@style/Polar.FormRow.Icon"
                        android:src="@drawable/ic_label" />

                    <TextView
                        android:id="@+id/tvDetailTags"
                        style="@style/Polar.FormRow.Text"
                        android:maxLines="3"
                        tools:text="#trabajo  #diseño" />
                </LinearLayout>
            </LinearLayout>

            <!-- Notas -->
            <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_screen"
                android:layout_marginEnd="@dimen/spacing_screen"
                android:layout_marginTop="12dp"
                android:autoLink="web|email"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface"
                android:textIsSelectable="true"
                tools:text="comentarios del equipo antes del viernes." />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/spacing_screen"
                android:layout_marginEnd="@dimen/spacing_screen"
                android:layout_marginTop="24dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- Subtareas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_screen"
                android:layout_marginEnd="@dimen/spacing_screen"
                android:layout_marginTop="20dp"
                android:text="@string/subtasks"
                android:textAppearance="@style/TextAppearance.Polar.Section" />

            <app.polar.ui.widget.MaxHeightRecyclerView
                android:id="@+id/recyclerDetailSubtasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fadeScrollbars="false"
                android:nestedScrollingEnabled="false"
                android:paddingStart="@dimen/spacing_screen"
                android:paddingEnd="@dimen/spacing_screen"
                android:scrollbars="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddSubtask"
                style="@style/Widget.Polar.Button.Text.Neutral"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="2dp"
                android:text="@string/add_subtask"
                app:icon="@drawable/ic_add"
                app:iconSize="18dp" />

            <!-- Fecha de creacion -->
            <TextView
                android:id="@+id/tvDetailDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_screen"
                android:layout_marginEnd="@dimen/spacing_screen"
                android:layout_marginTop="24dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="creada el 19 oct 2026" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
