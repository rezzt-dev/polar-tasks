<?xml version="1.0" encoding="utf-8"?>
<!-- Color de una prioridad en el editor de tema personalizado: nombre, color elegido y paleta -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/viewPriorityDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/circle_bg" />

        <TextView
            android:id="@+id/tvPriorityLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            tools:text="alta" />

        <TextView
            android:id="@+id/tvPriorityValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="rojo" />
    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/groupPriorityColors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:chipSpacingHorizontal="@dimen/custom_theme_swatch_spacing"
        app:chipSpacingVertical="@dimen/custom_theme_swatch_spacing" />
</LinearLayout>
