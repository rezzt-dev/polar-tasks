<?xml version="1.0" encoding="utf-8"?>
<!-- hoja inferior de una subtarea: titulo, aviso y acciones como filas -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        style="@style/Widget.Polar.BottomSheet.DragHandle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvSubtaskDetailTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnSurface"
        android:textIsSelectable="true"
        tools:text="revisar los cambios" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/containerDueDate"
            style="@style/Polar.FormRow"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                style="@style/Polar.FormRow.Icon"
                android:src="@drawable/ic_notifications" />

            <TextView
                android:id="@+id/tvSubtaskDueDate"
                style="@style/Polar.FormRow.Text"
                tools:text="@string/no_reminder" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="?attr/colorOutlineVariant" />

        <LinearLayout
            android:id="@+id/btnEdit"
            style="@style/Polar.FormRow"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                style="@style/Polar.FormRow.Icon"
                android:src="@drawable/ic_edit" />

            <TextView
                style="@style/Polar.FormRow.Text"
                android:text="@string/rename" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnDelete"
            style="@style/Polar.FormRow"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                style="@style/Polar.FormRow.Icon"
                android:src="@drawable/ic_trash"
                app:tint="?attr/colorError" />

            <TextView
                style="@style/Polar.FormRow.Text"
                android:text="@string/delete"
                android:textColor="?attr/colorError" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
