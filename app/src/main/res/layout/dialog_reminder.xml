<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:background="@drawable/dialog_background"
  android:padding="24dp">

  <TextView
    android:id="@+id/tvDialogTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/new_reminder"
    android:textSize="22sp"
    android:textStyle="bold"
    android:fontFamily="sans-serif-medium"
    android:gravity="center_horizontal"
    android:layout_marginBottom="16dp"
    android:textColor="?attr/colorOnSurface" />

  <com.google.android.material.textfield.TextInputLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="@string/task_title_hint"
    app:boxBackgroundColor="@android:color/transparent"
    style="@style/Widget.Material3.TextInputLayout.FilledBox">

    <com.google.android.material.textfield.TextInputEditText
      android:id="@+id/etTitle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textSize="18sp"
      android:textStyle="bold"
      android:inputType="textCapSentences"
      android:maxLines="1" />
  </com.google.android.material.textfield.TextInputLayout>

  <com.google.android.material.textfield.TextInputLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:hint="@string/task_description_hint"
    app:boxBackgroundColor="@android:color/transparent"
    style="@style/Widget.Material3.TextInputLayout.FilledBox">

    <com.google.android.material.textfield.TextInputEditText
      android:id="@+id/etDescription"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:inputType="textMultiLine|textCapSentences"
      android:minLines="2"
      android:maxLines="5"
      android:gravity="top" />
  </com.google.android.material.textfield.TextInputLayout>

  <LinearLayout
    android:id="@+id/btnDate"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground"
    android:paddingVertical="8dp">

    <ImageView
       android:layout_width="24dp"
       android:layout_height="24dp"
       android:src="@drawable/ic_schedule"
       app:tint="?attr/colorPrimary"/>

    <TextView
      android:id="@+id/tvDueDate"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:text="@string/select_date_time"
      android:textSize="16sp"
      android:textColor="?attr/colorOnSurface"/>

  </LinearLayout>

  <com.google.android.material.divider.MaterialDivider
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="12dp"
    app:dividerColor="?attr/colorOutlineVariant" />

  <!-- Location Switch -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/add_location"
      android:textSize="16sp"
      android:textColor="?attr/colorOnSurface"
      android:fontFamily="sans-serif-medium" />

    <com.google.android.material.materialswitch.MaterialSwitch
      android:id="@+id/switchLocation"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content" />

  </LinearLayout>

  <!-- Location Section (toggleable) -->
  <LinearLayout
    android:id="@+id/layoutLocationSection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- Google Maps Link Row -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:orientation="horizontal"
      android:gravity="center_vertical">

      <com.google.android.material.textfield.TextInputLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="@string/google_maps_link_hint"
        app:boxBackgroundColor="@android:color/transparent"
        style="@style/Widget.Material3.TextInputLayout.FilledBox">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etMapsLink"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="14sp"
          android:inputType="textUri"
          android:maxLines="3" />
      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExtract"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/extract_coordinates"
        style="@style/Widget.Material3.Button.TextButton"
        android:textSize="12sp" />

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:hint="nombre de la ubicacion (ej: casa)"
      app:boxBackgroundColor="@android:color/transparent"
      style="@style/Widget.Material3.TextInputLayout.FilledBox">

      <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/etLocationName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:inputType="textCapWords"
        android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:orientation="horizontal">

      <com.google.android.material.textfield.TextInputLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:hint="latitud"
        app:boxBackgroundColor="@android:color/transparent"
        style="@style/Widget.Material3.TextInputLayout.FilledBox">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etLatitude"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="16sp"
          android:inputType="numberDecimal|numberSigned"
          android:maxLines="1" />
      </com.google.android.material.textfield.TextInputLayout>

      <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

      <com.google.android.material.textfield.TextInputLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:hint="longitud"
        app:boxBackgroundColor="@android:color/transparent"
        style="@style/Widget.Material3.TextInputLayout.FilledBox">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etLongitude"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="16sp"
          android:inputType="numberDecimal|numberSigned"
          android:maxLines="1" />
      </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btnViewOnMap"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/view_on_map"
      style="@style/Widget.Material3.Button.TextButton"
      app:icon="@drawable/ic_location"
      app:iconTint="?attr/colorPrimary"
      app:iconGravity="textStart" />

  </LinearLayout>

  <com.google.android.material.divider.MaterialDivider
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="12dp"
    app:dividerColor="?attr/colorOutlineVariant" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:text="@string/cancel"
        style="@style/Widget.Material3.Button.TextButton"
        android:textColor="?attr/colorOnSurfaceVariant"/>

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btnSave"
      android:layout_width="0dp"
      android:layout_height="56dp"
      android:layout_weight="1"
      android:layout_marginStart="8dp"
      android:text="@string/save"
      style="@style/Widget.Polar.Button"
      app:cornerRadius="28dp"/>
  </LinearLayout>
</LinearLayout>
