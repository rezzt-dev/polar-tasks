<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootCompletedHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/bg_completed_header"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/ivCompletedHeaderCheck"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="10dp"
        android:alpha="0.6"
        android:contentDescription="@null"
        android:src="@drawable/ic_check_circle"
        app:tint="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/tvCompletedHeaderTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:alpha="0.8"
        android:letterSpacing="0.05"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="tareas realizadas (3)" />

    <ImageView
        android:id="@+id/ivCompletedHeaderArrow"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:alpha="0.6"
        android:contentDescription="@null"
        android:src="@drawable/ic_arrow_down"
        app:tint="?attr/colorOnSurface" />

</LinearLayout>
