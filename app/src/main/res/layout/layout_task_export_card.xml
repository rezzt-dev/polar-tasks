<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="380dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="2dp"
    android:background="@android:color/transparent">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="?attr/colorOnSurface"
        android:backgroundTint="?android:attr/colorBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Card Header: Brand + Priority Badge -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvBrandName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="polar."
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.9" />

                <!-- Priority Badge -->
                <TextView
                    android:id="@+id/tvPriorityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_tag_pill"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Prioridad Alta"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:visibility="visible" />
            </RelativeLayout>

            <!-- Divider line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="?android:attr/listDivider"
                android:alpha="0.2" />

            <!-- Task Title -->
            <TextView
                android:id="@+id/tvExportTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Título de la Tarea"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:lineSpacingMultiplier="1.1" />

            <!-- Task Description -->
            <TextView
                android:id="@+id/tvExportTaskDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Descripción detallada de la tarea..."
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.75"
                android:lineSpacingMultiplier="1.2"
                android:visibility="visible" />

            <!-- Subtasks Container -->
            <LinearLayout
                android:id="@+id/containerExportSubtasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Subtareas"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:alpha="0.85" />

                <LinearLayout
                    android:id="@+id/llSubtasksList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Meta Container: Due Date + Tags -->
            <LinearLayout
                android:id="@+id/containerExportMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Due Date indicator -->
                <LinearLayout
                    android:id="@+id/llExportDueDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_schedule"
                        app:tint="?attr/colorOnSurface"
                        android:alpha="0.7" />

                    <TextView
                        android:id="@+id/tvExportDueDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Mañana, 10:00"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.8" />
                </LinearLayout>

                <!-- Tags list -->
                <TextView
                    android:id="@+id/tvExportTags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#trabajo #importante"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
