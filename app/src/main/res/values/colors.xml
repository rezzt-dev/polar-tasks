  <color name="onyx_on_primary">#101010</color>             <!-- Text on primary -->
  <color name="onyx_primary_container">#2A2A2A</color>      <!-- Tonal button/container -->
  <color name="onyx_on_primary_container">#ECECEC</color>   <!-- Text on container -->
  <color name="onyx_secondary">#8C8C8C</color>              <!-- Muted accent -->
  <color name="onyx_on_secondary">#101010</color>           <!-- Text on secondary -->
  <color name="onyx_secondary_container">#202020</color>    <!-- Secondary tonal -->
  <color name="onyx_on_secondary_container">#ECECEC</color> <!-- Text on secondary container -->
  <color name="onyx_foreground">#ECECEC</color>             <!-- Primary text -->
  <color name="onyx_on_surface_variant">#B3B3B3</color>     <!-- Secondary/muted text -->
  <color name="onyx_border">#2A2A2A</color>                 <!-- Subtle borders -->
  <color name="onyx_outline_variant">#1C1C1C</color>        <!-- Even subtler borders -->
  <color name="onyx_error">#CF6679</color>                  <!-- Material dark red -->
  <color name="onyx_on_error">#101010</color>               <!-- Text on error -->
  <color name="onyx_success">#66BB6A</color>                <!-- Success green -->
